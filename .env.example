# NOTE: NEXT_PUBLIC_HOST_URL is the single source of truth for all SEO URLs
# (canonical, OG, JSON-LD, sitemap, robots). In production (Vercel env vars)
# it must be the canonical domain — never a *.vercel.app URL, or Google will
# index the vercel.app copy instead of the canonical domain.
NEXT_PUBLIC_HOST_URL="http://localhost:3000"
NEXT_PUBLIC_SELF_API="http://localhost:3000/api"

NEXT_PUBLIC_GA_ID="G-D1YJW1E4TR"